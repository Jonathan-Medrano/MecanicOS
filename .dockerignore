# Version control
.git
.gitignore

# Build artifacts and caches
.turbo
**/dist
**/.next
**/*.tsbuildinfo

# Dependencies (pnpm creates Windows junctions — must exclude)
**/node_modules

# Web app source (not needed for API container; package.json IS needed for workspace)
apps/web/src
apps/web/public
apps/web/.vercel

# Environment secrets
**/.env
**/.env.local
**/.env.*.local
**/.env.production

# Tooling
.claude
.agents
**/skills-lock.json

# Infra configs (not needed in container)
fly.toml
railway.json

# Docs and misc
**/README.md
**/*.log
