{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL", "DIRECT_URL", "CLERK_SECRET_KEY", "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY", "PORT", "WEB_URL", "NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_SITE_URL", "GEMINI_API_KEY"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}
