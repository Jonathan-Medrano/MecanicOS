{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node16",
    "target": "ES2021",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
