generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

// ─── Tenant (one per workshop) ──────────────────────────────────────────────

model Workshop {
  id        String   @id @default(uuid())
  clerkOrgId String  @unique
  name      String
  phone     String?
  address   String?
  botAutoReply    Boolean @default(false)
  botAutoReplyMsg String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients          Client[]
  vehicles         Vehicle[]
  workOrders       WorkOrder[]
  messages         Message[]
  employees        WorkshopEmployee[]
  botSessions      BotSession[]
  technicalGuides  TechnicalGuide[]
  payments         Payment[]
  parts            Part[]
  processes        Process[]

  @@map("workshops")
}

// ─── Client ─────────────────────────────────────────────────────────────────

model Client {
  id         String   @id @default(uuid())
  workshopId String
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  name       String
  phone      String
  email      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vehicles   Vehicle[]
  workOrders WorkOrder[]
  messages   Message[]

  @@unique([workshopId, phone])
  @@map("clients")
}

// ─── Vehicle ─────────────────────────────────────────────────────────────────

model Vehicle {
  id         String   @id @default(uuid())
  workshopId String
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  brand           String
  model           String
  year            Int
  plate           String
  vin             String?
  color           String?
  notes           String?
  nextServiceDate DateTime?
  nextServiceKm   Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workOrders WorkOrder[]

  @@unique([workshopId, plate])
  @@map("vehicles")
}

// ─── Work Order ──────────────────────────────────────────────────────────────

model WorkOrder {
  id         String          @id @default(uuid())
  workshopId String
  workshop   Workshop        @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  clientId   String
  client     Client          @relation(fields: [clientId], references: [id])
  vehicleId  String
  vehicle    Vehicle         @relation(fields: [vehicleId], references: [id])

  status         WorkOrderStatus @default(PENDING)
  paymentStatus  PaymentStatus   @default(UNPAID)
  paymentMethod  PaymentMethod?
  description    String
  mechanicNotes  String?
  estimatedCost  Decimal?        @db.Decimal(10, 2)
  finalCost      Decimal?        @db.Decimal(10, 2)
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  budgetApproved Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  assignedToId  String?
  assignedTo    WorkshopEmployee? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  items    WorkOrderItem[]
  payments Payment[]

  @@index([workshopId])
  @@index([workshopId, status])
  @@index([workshopId, scheduledAt])
  @@map("work_orders")
}

// ─── Work Order Items ─────────────────────────────────────────────────────────

model WorkOrderItem {
  id          String            @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  type        WorkOrderItemType
  description String
  quantity    Decimal           @db.Decimal(10, 3)
  unitPrice   Decimal           @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@map("work_order_items")
}

enum WorkOrderItemType {
  PART
  LABOR
}

enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  WAITING_PARTS
  DONE
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  MIXED
}

// ─── Technical Guides ────────────────────────────────────────────────────────

model TechnicalGuide {
  id         String   @id @default(uuid())
  workshopId String
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  title      String
  vehicle    String?
  category   String?
  content    String
  embedding  Unsupported("vector(768)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workshopId])
  @@map("technical_guides")
}

// ─── Employees ───────────────────────────────────────────────────────────────

model WorkshopEmployee {
  id          String   @id @default(uuid())
  workshopId  String
  workshop    Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  clerkUserId String?  @unique   // null until they accept the invite
  email       String
  phone       String?            // for WhatsApp bot identification
  name        String
  permissions String[]           // e.g. ["VIEW_ORDERS","EDIT_ORDERS"]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  workOrders WorkOrder[]

  @@unique([workshopId, email])
  @@map("workshop_employees")
}

// ─── WhatsApp Bot Sessions ────────────────────────────────────────────────────

model BotSession {
  id         String   @id @default(uuid())
  workshopId String
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  phone      String
  step       String   @default("IDLE")
  context    Json?

  updatedAt DateTime @updatedAt

  @@unique([workshopId, phone])
  @@map("bot_sessions")
}

// ─── WhatsApp Messages ───────────────────────────────────────────────────────

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model Message {
  id         String           @id @default(uuid())
  workshopId String
  workshop   Workshop         @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  phone      String
  clientId   String?
  client     Client?          @relation(fields: [clientId], references: [id])

  direction  MessageDirection
  body       String
  waMsgId    String?          @unique

  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([workshopId, phone])
  @@index([workshopId, createdAt(sort: Desc)])
  @@map("messages")
}

// ─── Payment records ─────────────────────────────────────────────────────────

model Payment {
  id          String        @id @default(uuid())
  workshopId  String
  workshop    Workshop      @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  workOrderId String
  workOrder   WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  note      String?
  createdAt DateTime      @default(now())

  @@index([workOrderId])
  @@map("payments")
}

// ─── Parts Inventory ─────────────────────────────────────────────────────────

model Part {
  id          String   @id @default(uuid())
  workshopId  String
  workshop    Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  name        String
  description String?
  sku         String?
  stock       Decimal  @db.Decimal(10, 3) @default(0)
  minStock    Decimal  @db.Decimal(10, 3) @default(0)
  costPrice   Decimal? @db.Decimal(10, 2)
  sellPrice   Decimal? @db.Decimal(10, 2)
  unit        String   @default("unidad")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workshopId])
  @@map("parts")
}

// ─── Intelligent Processes ────────────────────────────────────────────────────

model Process {
  id         String   @id @default(uuid())
  workshopId String
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  name             String
  description      String?
  category         String?
  estimatedMinutes Int?

  steps     ProcessStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workshopId])
  @@map("processes")
}

model ProcessStep {
  id        String  @id @default(uuid())
  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  order           Int
  title           String
  description     String?
  durationMinutes Int?

  tools StepTool[]

  @@map("process_steps")
}

model StepTool {
  id     String      @id @default(uuid())
  stepId String
  step   ProcessStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  name     String
  type     StepToolType
  quantity Int          @default(1)

  @@map("step_tools")
}

enum StepToolType {
  TOOL
  PART
  FLUID
}
