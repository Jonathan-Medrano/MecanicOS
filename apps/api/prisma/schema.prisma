generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Tenant (one per workshop) ──────────────────────────────────────────────

model Workshop {
  id        String   @id @default(uuid())
  clerkOrgId String  @unique
  name      String
  phone     String?
  address   String?
  botAutoReply    Boolean @default(false)
  botAutoReplyMsg String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients          Client[]
  vehicles         Vehicle[]
  workOrders       WorkOrder[]
  messages         Message[]
  employees        WorkshopEmployee[]
  botSessions      BotSession[]
  technicalGuides  TechnicalGuide[]

  @@map("workshops")
}

// ─── Client ─────────────────────────────────────────────────────────────────

model Client {
  id         String   @id @default(uuid())
  workshopId String
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  name       String
  phone      String
  email      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vehicles   Vehicle[]
  workOrders WorkOrder[]
  messages   Message[]

  @@unique([workshopId, phone])
  @@map("clients")
}

// ─── Vehicle ─────────────────────────────────────────────────────────────────

model Vehicle {
  id         String   @id @default(uuid())
  workshopId String
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  brand     String
  model     String
  year      Int
  plate     String
  vin       String?
  color     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workOrders WorkOrder[]

  @@unique([workshopId, plate])
  @@map("vehicles")
}

// ─── Work Order ──────────────────────────────────────────────────────────────

model WorkOrder {
  id         String          @id @default(uuid())
  workshopId String
  workshop   Workshop        @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  clientId   String
  client     Client          @relation(fields: [clientId], references: [id])
  vehicleId  String
  vehicle    Vehicle         @relation(fields: [vehicleId], references: [id])

  status        WorkOrderStatus @default(PENDING)
  paymentStatus PaymentStatus   @default(UNPAID)
  description   String
  mechanicNotes String?
  estimatedCost Decimal?        @db.Decimal(10, 2)
  finalCost     Decimal?        @db.Decimal(10, 2)
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  items WorkOrderItem[]

  @@index([workshopId])
  @@index([workshopId, status])
  @@index([workshopId, scheduledAt])
  @@map("work_orders")
}

// ─── Work Order Items ─────────────────────────────────────────────────────────

model WorkOrderItem {
  id          String            @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  type        WorkOrderItemType
  description String
  quantity    Decimal           @db.Decimal(10, 3)
  unitPrice   Decimal           @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@map("work_order_items")
}

enum WorkOrderItemType {
  PART
  LABOR
}

enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  WAITING_PARTS
  DONE
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

// ─── Technical Guides ────────────────────────────────────────────────────────

model TechnicalGuide {
  id         String   @id @default(uuid())
  workshopId String
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  title      String
  vehicle    String?   // e.g. "Toyota Corolla 2019"
  category   String?   // e.g. "Frenos", "Motor", "Transmisión"
  content    String    // full guide text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workshopId])
  @@map("technical_guides")
}

// ─── Employees ───────────────────────────────────────────────────────────────

model WorkshopEmployee {
  id          String   @id @default(uuid())
  workshopId  String
  workshop    Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  clerkUserId String?  @unique   // null until they accept the invite
  email       String
  phone       String?            // for WhatsApp bot identification
  name        String
  permissions String[]           // e.g. ["VIEW_ORDERS","EDIT_ORDERS"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workshopId, email])
  @@map("workshop_employees")
}

// ─── WhatsApp Bot Sessions ────────────────────────────────────────────────────

model BotSession {
  id         String   @id @default(uuid())
  workshopId String
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  phone      String
  step       String   @default("IDLE")
  context    Json?

  updatedAt DateTime @updatedAt

  @@unique([workshopId, phone])
  @@map("bot_sessions")
}

// ─── WhatsApp Messages ───────────────────────────────────────────────────────

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model Message {
  id         String           @id @default(uuid())
  workshopId String
  workshop   Workshop         @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  phone      String
  clientId   String?
  client     Client?          @relation(fields: [clientId], references: [id])

  direction  MessageDirection
  body       String
  waMsgId    String?          @unique

  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([workshopId, phone])
  @@index([workshopId, createdAt(sort: Desc)])
  @@map("messages")
}
